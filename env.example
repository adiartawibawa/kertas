# Salin file ini jadi .env untuk development lokal.
#
# --- Domain kanonik situs (WAJIB) ---
# Dipakai otomatis oleh @nuxtjs/sitemap, canonical URL, hreflang, dan
# semua schema JSON-LD lewat useSiteConfig().
NUXT_SITE_URL=http://localhost:3000

# --- Environment override (OPSIONAL) ---
# JANGAN diisi untuk dev lokal maupun production sungguhan — keduanya
# sudah otomatis benar karena `nuxt dev` set NODE_ENV=development dan
# `nuxt generate`/`nuxt build` set NODE_ENV=production secara otomatis.
#
# Isi HANYA kalau kamu men-generate build untuk domain staging/preview
# (build tetap dianggap "production" oleh Nuxt CLI meski tujuannya bukan
# domain utama) — supaya @nuxtjs/robots tidak salah mengizinkan indexing
# di staging. Nilai bebas asal bukan "production", contoh:
# NUXT_SITE_ENV=staging
