# Staging/preview (OPSIONAL — hanya perlu file ini kalau kamu memang punya
# domain staging terpisah, misal staging.kertaas.com).
#
# NUXT_SITE_ENV wajib diisi di sini dan HARUS bukan "production" — karena
# `nuxt generate` secara default akan tetap menganggap build sebagai
# production (NODE_ENV=production selalu diset otomatis oleh Nuxt CLI
# untuk command generate/build, terlepas environment tujuannya apa).
# Tanpa baris ini, staging bisa ikut ter-index Google secara tidak sengaja.
NUXT_SITE_URL=https://staging.kertaas.com
NUXT_SITE_ENV=staging
